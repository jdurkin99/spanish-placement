    "preterite_irregular": { "level": "A2", "label": "Preterite (irregular)" },
    "imperfect":        { "level": "A2", "label": "Imperfect" },
    "ir_a":             { "level": "A2", "label": "ir a + infinitive" },
    "do_pronouns":      { "level": "A2", "label": "Direct object pronouns" },
    "comparatives":     { "level": "A2", "label": "Comparatives" },
    "estar_gerund":     { "level": "A2", "label": "estar + gerund" },

    "pret_vs_imp":      { "level": "B1", "label": "Preterite vs. imperfect in context" },
    "double_pronouns":  { "level": "B1", "label": "Double object pronouns (se lo)" },
    "present_perfect":  { "level": "B1", "label": "Present perfect" },
    "future":           { "level": "B1", "label": "Future tense" },
    "conditional":      { "level": "B1", "label": "Conditional" },
    "commands_pronouns":{ "level": "B1", "label": "Commands with pronouns" },
    "subj_present":     { "level": "B1", "label": "Present subjunctive (wishes/emotion/doubt)" },
    "por_para":         { "level": "B1", "label": "por vs. para" },
    "relative_clauses": { "level": "B1", "label": "Relative clauses" },

    "subj_conjunctions":{ "level": "B2", "label": "Subjunctive after conjunctions (para que, cuando, antes de que)" },
