    { "id": "b2-subjrel-2", "structure": "subj_relative", "q": "No conozco a nadie que ___ hablar japonés.", "answer": "sepa", "distractors": ["sabe", "supe", "sabría"], "why": "Non-existent antecedent (nadie) → subjunctive." },
